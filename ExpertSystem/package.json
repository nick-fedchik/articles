{
  "name": "expert-system-articles-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "npm run validate:source && npm run validate:markdown && npm run validate:github && npm run validate:gitlab",
    "validate:source": "node scripts/validate-source-conventions.mjs",
    "validate:markdown": "markdownlint-cli2 \"*.md\"",
    "validate:github": "node scripts/validate-github-markdown.mjs",
    "validate:gitlab": "node scripts/validate-gitlab-markdown.mjs"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "markdownlint-cli2": "^0.23.2",
    "mathjax": "^4.1.3",
    "mermaid": "^11.17.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
