{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "source_language": "uk",
  "target_language": "kk",
  "domain": "Mission-critical expert systems, functional safety, formal methods",
  "terms": {
    "експертна система": "сараптамалық жүйе (expert system)",
